{
  "admin_username": "admin",
  "admin_password": "admin",
  "api_key": "",
  "cookie_import_api_key": "",
  "proxy": "",
  "use_proxy": false,
  "resource_proxy": "",
  "resource_use_proxy": false,
  "leonardo_upload_proxy_mode": "basic",
  "leonardo_upload_proxy": "",
  "public_base_url": "http://127.0.0.1:8787/",
  "generate_timeout": 300,
  "retry_enabled": true,
  "retry_max_attempts": 3,
  "retry_backoff_seconds": 1,
  "retry_on_status_codes": [429, 451, 500, 502, 503, 504],
  "retry_on_error_types": ["timeout", "connection", "proxy"],
  "retry_same_token_error_types": ["provider_moderation_error", "provider_output_error"],
  "token_rotation_strategy": "round_robin",
  "token_max_running_tasks": 2,
  "token_success_auto_disable_enabled": false,
  "token_success_auto_disable_threshold": 2,
  "refresh_interval_minutes": 15,
  "auto_refresh_max_concurrency": 5,
  "auto_refresh_sweep_interval_minutes": 1,
  "jwt_refresh_margin_minutes": 5,
  "batch_concurrency": 10,
  "exhausted_token_auto_cleanup_enabled": false,
  "exhausted_token_auto_cleanup_interval_hours": 24,
  "request_log_retention_limit": 5000,
  "generated_max_size_mb": 40960,
  "generated_prune_size_mb": 200,
  "use_upstream_result_url": false
}
